# Kopieer dit bestand naar .env en vul je eigen Supabase-projectgegevens in.
# Te vinden in je Supabase-project onder Project Settings → API.

VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key

# Server-side secret voor /api/matches.js (football-data.org).
# GEEN VITE_-prefix: deze key mag nooit naar de browser, dus alleen lokaal in
# .env (voor `vercel dev`) en als Environment Variable in Vercel instellen.
FOOTBALL_DATA_TOKEN=jouw-football-data-token
